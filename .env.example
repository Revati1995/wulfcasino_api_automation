# Copy this file to .env and fill in the real credentials.
#
#   cp .env.example .env      (PowerShell: Copy-Item .env.example .env)
#
# .env is git-ignored because it holds passwords, so a fresh clone never has
# one. Ask the team for the credential values - the URLs below are correct for
# the shared staging environment and need no change.

NODE_ENV=staging

# API Base URLs.
# All three roles share one host; the clients add their own /api/v1... prefixes.
BASE_URL=https://api-staging.wulfcasino.com/api/v1
ADMIN_API_URL=https://api-staging.wulfcasino.com
PLAYER_API_URL=https://api-staging.wulfcasino.com
AGENT_API_URL=https://api-staging.wulfcasino.com

# Authentication Credentials - Admin (staff login, POST /api/v1/admin/auth/login)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Authentication Credentials - Player (POST /api/v1/auth/login, sent as "entity")
PLAYER_EMAIL=
PLAYER_PASSWORD=

# Authentication Credentials - Agent (staff login, same endpoint as admin)
AGENT_EMAIL=
AGENT_PASSWORD=

# Test Configuration
TEST_TIMEOUT=60000
API_TIMEOUT=30000
RETRY_COUNT=3

# Logging
LOG_LEVEL=info
LOG_TO_FILE=true

# Test Data
USE_REAL_DATA=false
CLEANUP_TEST_DATA=true

# Optional: External Service Keys
WEBHOOK_SECRET=
API_KEY=
