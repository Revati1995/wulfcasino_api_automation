# Environment Configuration
NODE_ENV=local

# API Base URLs
BASE_URL=http://localhost:3000
ADMIN_API_URL=http://localhost:3000/admin
PLAYER_API_URL=http://localhost:3000/player
AGENT_API_URL=http://localhost:3000/agent

# Authentication Credentials - Admin
ADMIN_EMAIL=admin@wulfcasino.com
ADMIN_PASSWORD=SecurePassword123!

# Authentication Credentials - Player
PLAYER_EMAIL=player@test.com
PLAYER_PASSWORD=PlayerPass123!

# Authentication Credentials - Agent
AGENT_EMAIL=agent@test.com
AGENT_PASSWORD=AgentPass123!

# Test Configuration
TEST_TIMEOUT=60000
API_TIMEOUT=30000
RETRY_COUNT=3

# Logging
LOG_LEVEL=info
LOG_TO_FILE=true

# Test Data
USE_REAL_DATA=false
CLEANUP_TEST_DATA=true

# Optional: External Service Keys
WEBHOOK_SECRET=your-webhook-secret
API_KEY=your-api-key
